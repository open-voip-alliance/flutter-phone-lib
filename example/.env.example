# Pre-fills the SIP credentials in debug builds of the example app.
# Copy this file to .env (git-ignored) and fill in your details.
#
# The VoIP account to register with (not your VoIPGRID portal login): in the
# VoIPGRID portal go to Telephony > VoIP accounts and open the account you want
# to use. Its ID and password are shown there.
VOIP_ACCOUNT_ID=
VOIP_ACCOUNT_PASSWORD=

# The encrypted VoIPGRID SIP proxy; normally these don't need changing.
SIP_DOMAIN=sip.encryptedsip.com
SIP_PORT=5061

# Optional: your VoIPGRID portal login. The app exchanges it for an API token
# and registers with the middleware so incoming calls wake the app up with a
# push notification. Leave empty to skip; outgoing calls work without it.
VOIPGRID_USERNAME=
VOIPGRID_PASSWORD=
